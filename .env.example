# Yandex Cloud API key (IAM или API-ключ сервисного аккаунта)
# Получить: https://console.yandex.cloud → IAM → Сервисные аккаунты → API-ключ
ALICE_YC_API_KEY=<your-yandex-cloud-api-key>

# ID каталога Yandex Cloud (folder ID)
ALICE_YC_FOLDER_ID=b1g6co0cfokq8k24mu7n

# ID агента в Agent Atelier (с встроенным WebSearch)
ALICE_YC_PROMPT_ID=fvtvl13pf2lknmsk33to

# Поведение агента
ALICE_MAX_AGENT_STEPS=15
ALICE_VERBOSE=false
